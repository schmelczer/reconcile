{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ESNext",
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationDir": "./dist/types",
    "rootDir": "./src",
    "skipLibCheck": true,
    "inlineSourceMap": true
  },
  "exclude": ["src/**/*.test.ts"]
}
